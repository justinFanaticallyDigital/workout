generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── NextAuth ─────────────────────────────────────────────
model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Users ───────────────────────────────────────────────
model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  name          String?
  password      String?
  image         String?
  emailVerified DateTime? @map("email_verified")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts       Account[]
  sessions       Session[]
  goals          Goal[]
  programs       Program[]
  workouts       Workout[]
  exercises      Exercise[]
  exercisePrs    ExercisePr[]
  bodyMetrics    BodyMetric[]
  dailyMetrics   DailyMetric[]
  progressPhotos ProgressPhoto[]
  injuries       Injury[]
  foodItems          FoodItem[]
  meals              Meal[]
  nutritionTargets   NutritionTarget[]
  mealPlans          MealPlan[]
  activityLogs       ActivityLog[]
  integrationData    IntegrationData[]
  userMetricTargets  UserMetricTarget[]
  scheduleOverrides  ScheduleOverride[]
  stretchRoutines    StretchRoutine[]

  @@map("users")
}

// ─── Goals ───────────────────────────────────────────────
enum GoalType {
  weight
  bodyweight
  strength
  powerlifting
  competition
  frequency
  bodycomp
  custom
}

enum GoalStatus {
  active
  achieved
  abandoned
}

model Goal {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  programId   String?    @map("program_id") @db.Uuid
  type        GoalType
  title       String
  description String?
  priority    String     @default("primary")
  metric      String?
  startValue  Decimal?   @map("start_value")
  targetValue Decimal?   @map("target_value")
  targetUnit  String?    @map("target_unit")
  targetDate  DateTime?  @map("target_date") @db.Date
  status      GoalStatus @default(active)
  createdAt   DateTime   @default(now()) @map("created_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  program          Program?          @relation("GoalProgram", fields: [programId], references: [id], onDelete: SetNull)
  programs         Program[]         @relation("ProgramGoal")
  nutritionTargets NutritionTarget[]

  @@index([userId])
  @@index([programId])
  @@map("goals")
}

// ─── Programs ────────────────────────────────────────────
enum ProgramStatus {
  active
  completed
  paused
}

model Program {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  goalId        String?       @map("goal_id") @db.Uuid
  name          String
  description   String?
  startDate     DateTime?     @map("start_date") @db.Date
  endDate       DateTime?     @map("end_date") @db.Date
  durationWeeks Int?          @map("duration_weeks")
  status        ProgramStatus @default(active)
  createdAt     DateTime      @default(now()) @map("created_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal              Goal?              @relation("ProgramGoal", fields: [goalId], references: [id], onDelete: SetNull)
  goals             Goal[]             @relation("GoalProgram")
  blocks            Block[]
  benchmarks        ProgramBenchmark[]
  progressPhotos    ProgressPhoto[]
  userMetricTargets UserMetricTarget[]
  scheduleOverrides ScheduleOverride[]

  @@index([userId])
  @@index([userId, status])
  @@map("programs")
}

model ProgramBenchmark {
  id          String    @id @default(uuid()) @db.Uuid
  programId   String    @map("program_id") @db.Uuid
  blockId     String?   @map("block_id") @db.Uuid
  label       String
  targetValue Decimal   @map("target_value")
  targetUnit  String    @map("target_unit")
  targetDate  DateTime? @map("target_date") @db.Date
  actualValue Decimal?  @map("actual_value")
  achievedAt  DateTime? @map("achieved_at")

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  block   Block?  @relation(fields: [blockId], references: [id], onDelete: SetNull)

  @@index([programId])
  @@index([blockId])
  @@map("program_benchmarks")
}

// ─── Blocks ──────────────────────────────────────────────
enum BlockStatus {
  active
  completed
  upcoming
}

model Block {
  id                  String      @id @default(uuid()) @db.Uuid
  programId           String      @map("program_id") @db.Uuid
  name                String
  description         String?
  blockNumber         Int         @map("block_number")
  startDate           DateTime?   @map("start_date") @db.Date
  endDate             DateTime?   @map("end_date") @db.Date
  durationWeeks       Int?        @map("duration_weeks")
  scheduleDaysPerWeek Int?        @map("schedule_days_per_week")
  phase               String?
  focus               String?
  status              BlockStatus @default(upcoming)
  createdAt           DateTime    @default(now()) @map("created_at")

  program           Program            @relation(fields: [programId], references: [id], onDelete: Cascade)
  days              BlockDay[]
  workouts          Workout[]
  benchmarks        ProgramBenchmark[]
  nutritionTargets  NutritionTarget[]
  scheduleOverrides ScheduleOverride[]

  @@index([programId])
  @@map("blocks")
}

// ─── Block Days (Templates) ──────────────────────────────
enum DayType {
  lifting
  cardio
  conditioning
  mobility
  rest
}

model BlockDay {
  id        String  @id @default(uuid()) @db.Uuid
  blockId   String  @map("block_id") @db.Uuid
  dayNumber Int     @map("day_number")
  name      String
  dayType   DayType @default(lifting) @map("day_type")
  sortOrder Int     @map("sort_order")

  block     Block              @relation(fields: [blockId], references: [id], onDelete: Cascade)
  exercises BlockDayExercise[]
  workouts  Workout[]

  @@index([blockId])
  @@map("block_days")
}

// ─── Block Day Exercises (Templates) ─────────────────────
enum ProgressionType {
  linear
  double
  wave
  rpe_based
  percentage_based
  none
}

model BlockDayExercise {
  id                    String          @id @default(uuid()) @db.Uuid
  blockDayId            String          @map("block_day_id") @db.Uuid
  exerciseId            String          @map("exercise_id") @db.Uuid
  altExerciseId         String?         @map("alt_exercise_id") @db.Uuid
  sortOrder             Int             @map("sort_order")
  targetSets            Int?            @map("target_sets")
  targetRepRange        String?         @map("target_rep_range")
  targetRpe             String?         @map("target_rpe")
  progressionType       ProgressionType @default(none) @map("progression_type")
  progressionIncrement  Decimal?        @map("progression_increment")
  notes                 String?

  blockDay    BlockDay  @relation(fields: [blockDayId], references: [id], onDelete: Cascade)
  exercise    Exercise  @relation("primary", fields: [exerciseId], references: [id], onDelete: Cascade)
  altExercise Exercise? @relation("alternate", fields: [altExerciseId], references: [id], onDelete: SetNull)

  @@index([blockDayId])
  @@index([exerciseId])
  @@map("block_day_exercises")
}

// ─── Workouts (Logged Sessions) ──────────────────────────
model Workout {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  blockId    String?   @map("block_id") @db.Uuid
  blockDayId String?   @map("block_day_id") @db.Uuid
  date       DateTime  @db.Date
  weekNumber Int?      @map("week_number")
  startTime  DateTime? @map("start_time")
  endTime    DateTime? @map("end_time")
  notes      String?
  rating     Int?
  bodyWeight Decimal?  @map("body_weight")
  createdAt  DateTime  @default(now()) @map("created_at")

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  block     Block?            @relation(fields: [blockId], references: [id], onDelete: SetNull)
  blockDay  BlockDay?         @relation(fields: [blockDayId], references: [id], onDelete: SetNull)
  exercises WorkoutExercise[]

  @@index([userId])
  @@index([userId, date])
  @@index([blockId])
  @@map("workouts")
}

model WorkoutExercise {
  id         String  @id @default(uuid()) @db.Uuid
  workoutId  String  @map("workout_id") @db.Uuid
  exerciseId String  @map("exercise_id") @db.Uuid
  sortOrder  Int     @map("sort_order")
  notes      String?

  workout  Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sets     Set[]

  @@index([workoutId])
  @@index([exerciseId])
  @@map("workout_exercises")
}

model Set {
  id                String   @id @default(uuid()) @db.Uuid
  workoutExerciseId String   @map("workout_exercise_id") @db.Uuid
  setNumber         Int      @map("set_number")
  weight            Decimal?
  reps              Int?
  rir               Int?
  rpe               Decimal?
  isWarmup          Boolean  @default(false) @map("is_warmup")
  isPr              Boolean  @default(false) @map("is_pr")
  notes             String?

  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  exercisePrs     ExercisePr[]

  @@index([workoutExerciseId])
  @@map("sets")
}

// ─── Exercise Library ────────────────────────────────────
model Exercise {
  id               String  @id @default(uuid()) @db.Uuid
  userId           String? @map("user_id") @db.Uuid
  name             String
  movementPattern  String? @map("movement_pattern")
  primaryMuscle    String? @map("primary_muscle")
  secondaryMuscle1 String? @map("secondary_muscle_1")
  secondaryMuscle2 String? @map("secondary_muscle_2")
  equipment        String?
  isCustom         Boolean @default(false) @map("is_custom")
  createdAt        DateTime @default(now()) @map("created_at")

  user                 User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercisePrs          ExercisePr[]
  workoutExercises     WorkoutExercise[]
  blockDayExercises    BlockDayExercise[] @relation("primary")
  blockDayExercisesAlt BlockDayExercise[] @relation("alternate")
  stretchRoutineItems  StretchRoutineItem[]

  @@unique([name])
  @@index([primaryMuscle])
  @@map("exercises")
}

model ExercisePr {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  exerciseId   String   @map("exercise_id") @db.Uuid
  prType       String   @map("pr_type") // weight, reps, volume, e1rm
  value        Decimal
  repsAtWeight Int?     @map("reps_at_weight")
  setId        String?  @map("set_id") @db.Uuid
  achievedAt   DateTime @default(now()) @map("achieved_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  set      Set?     @relation(fields: [setId], references: [id], onDelete: SetNull)

  @@index([userId, exerciseId])
  @@index([userId, exerciseId, prType])
  @@map("exercise_prs")
}

// ─── Body Metrics & Progress ─────────────────────────────
model BodyMetric {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  date      DateTime @db.Date
  weight    Decimal?
  bodyFatPct Decimal? @map("body_fat_pct")
  source    String   @default("manual") // manual, fitbit, scale
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
  @@map("body_metrics")
}

// ─── Daily Metrics (Fitbit activity/sleep/HR) ───────────
model DailyMetric {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  date             DateTime @db.Date
  // Activity
  steps            Int?
  activeMinutes    Int?     @map("active_minutes")
  caloriesBurned   Int?     @map("calories_burned")
  // Sleep
  sleepMinutes     Int?     @map("sleep_minutes")
  sleepDeep        Int?     @map("sleep_deep")       // minutes
  sleepLight       Int?     @map("sleep_light")      // minutes
  sleepRem         Int?     @map("sleep_rem")        // minutes
  sleepWake        Int?     @map("sleep_wake")       // minutes
  // Heart Rate
  restingHr        Int?     @map("resting_hr")
  // Source
  source           String   @default("fitbit")
  createdAt        DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, source])
  @@index([userId])
  @@index([userId, date])
  @@map("daily_metrics")
}

model ProgressPhoto {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  programId String?  @map("program_id") @db.Uuid
  date      DateTime @db.Date
  imageUrl  String   @map("image_url")
  poseType  String   @default("front") @map("pose_type") // front, side, back, custom
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("progress_photos")
}

// ─── Injuries ────────────────────────────────────────────
model Injury {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  bodyPart     String    @map("body_part")
  description  String?
  severity     String    @default("tweak") // tweak, mild, moderate, severe
  onsetDate    DateTime  @map("onset_date") @db.Date
  resolvedDate DateTime? @map("resolved_date") @db.Date
  status       String    @default("active") // active, monitoring, resolved
  createdAt    DateTime  @default(now()) @map("created_at")

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes InjuryNote[]

  @@index([userId])
  @@map("injuries")
}

model InjuryNote {
  id          String    @id @default(uuid()) @db.Uuid
  injuryId    String    @map("injury_id") @db.Uuid
  date        DateTime  @db.Date
  note        String
  treatment   String?
  followUpDate DateTime? @map("follow_up_date") @db.Date

  injury Injury @relation(fields: [injuryId], references: [id], onDelete: Cascade)

  @@index([injuryId])
  @@map("injury_notes")
}

// ─── Nutrition ──────────────────────────────────────────
model FoodItem {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  name        String
  brand       String?
  barcode     String?
  servingSize Decimal  @default(100) @map("serving_size")
  servingUnit String   @default("g") @map("serving_unit")
  calories    Decimal  @default(0)
  protein     Decimal  @default(0)
  carbs       Decimal  @default(0)
  fat         Decimal  @default(0)
  fiber       Decimal? @default(0)
  sugar       Decimal? @default(0)
  sodium      Decimal? @default(0)
  source      String   @default("custom") // custom, usda, openfoodfacts
  externalId  String?  @map("external_id")
  isCustom    Boolean  @default(true) @map("is_custom")
  createdAt   DateTime @default(now()) @map("created_at")

  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealItems     MealItem[]
  mealPlanItems MealPlanItem[]

  @@index([userId])
  @@index([barcode])
  @@index([name])
  @@map("food_items")
}

enum MealType {
  breakfast
  lunch
  dinner
  snack
}

model Meal {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  date     DateTime @db.Date
  mealType MealType @map("meal_type")
  notes    String?
  createdAt DateTime @default(now()) @map("created_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items MealItem[]

  @@index([userId])
  @@index([userId, date])
  @@map("meals")
}

model MealItem {
  id         String  @id @default(uuid()) @db.Uuid
  mealId     String  @map("meal_id") @db.Uuid
  foodItemId String  @map("food_item_id") @db.Uuid
  quantity   Decimal @default(1)
  sortOrder  Int     @default(0) @map("sort_order")

  meal     Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  foodItem FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Cascade)

  @@index([mealId])
  @@map("meal_items")
}

model NutritionTarget {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  label     String   @default("Default")
  calories  Decimal?
  protein   Decimal?
  carbs     Decimal?
  fat       Decimal?
  isActive  Boolean  @default(true) @map("is_active")
  blockId   String?  @map("block_id") @db.Uuid
  goalId    String?  @map("goal_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  block Block? @relation(fields: [blockId], references: [id], onDelete: SetNull)
  goal  Goal?  @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([blockId])
  @@index([goalId])
  @@map("nutrition_targets")
}

// ─── Meal Plans ──────────────────────────────────────────
model MealPlan {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  name            String
  days            Int      @default(7)
  calorieTarget   Decimal? @map("calorie_target")
  proteinPct      Decimal? @map("protein_pct")
  carbsPct        Decimal? @map("carbs_pct")
  fatPct          Decimal? @map("fat_pct")
  mealsPerDay     Int      @default(3) @map("meals_per_day")
  preferences     String?
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  planDays MealPlanDay[]

  @@index([userId])
  @@map("meal_plans")
}

model MealPlanDay {
  id         String   @id @default(uuid()) @db.Uuid
  planId     String   @map("plan_id") @db.Uuid
  dayNumber  Int      @map("day_number")
  createdAt  DateTime @default(now()) @map("created_at")

  plan  MealPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  meals MealPlanMeal[]

  @@index([planId])
  @@map("meal_plan_days")
}

model MealPlanMeal {
  id       String  @id @default(uuid()) @db.Uuid
  dayId    String  @map("day_id") @db.Uuid
  mealType MealType @map("meal_type")
  sortOrder Int    @default(0) @map("sort_order")

  day   MealPlanDay      @relation(fields: [dayId], references: [id], onDelete: Cascade)
  items MealPlanItem[]

  @@index([dayId])
  @@map("meal_plan_meals")
}

model MealPlanItem {
  id         String  @id @default(uuid()) @db.Uuid
  mealId     String  @map("meal_id") @db.Uuid
  foodItemId String  @map("food_item_id") @db.Uuid
  quantity   Decimal @default(1)
  sortOrder  Int     @default(0) @map("sort_order")

  meal     MealPlanMeal @relation(fields: [mealId], references: [id], onDelete: Cascade)
  foodItem FoodItem     @relation(fields: [foodItemId], references: [id], onDelete: Cascade)

  @@index([mealId])
  @@map("meal_plan_items")
}

// ─── Activity Log (non-lifting activities) ──────────────
enum ActivityType {
  STRETCH
  HIIT
  LISS
  CLASS
  CUSTOM
}

enum Intensity {
  LIGHT
  MODERATE
  HARD
}

model ActivityLog {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  date           DateTime     @db.Date
  activityType   ActivityType @map("activity_type")
  subType        String?      @map("sub_type")
  durationMin    Int          @map("duration_min")
  intensity      Intensity?
  distanceKm     Float?       @map("distance_km")
  avgHeartRate   Int?         @map("avg_heart_rate")
  caloriesBurned Int?         @map("calories_burned")
  instructor     String?
  studio         String?
  notes          String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("activity_logs")
}

// ─── Integration Data (Fitbit, Apple Health, etc.) ──────
enum IntegrationSource {
  FITBIT
  APPLE_HEALTH
  GARMIN
  MANUAL
}

model IntegrationData {
  id         String            @id @default(uuid()) @db.Uuid
  userId     String            @map("user_id") @db.Uuid
  source     IntegrationSource
  metricType String            @map("metric_type")
  value      Float
  date       DateTime          @db.Date
  rawPayload Json?             @map("raw_payload")
  createdAt  DateTime          @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, metricType, date])
  @@index([userId, metricType, date])
  @@map("integration_data")
}

// ─── User Metric Targets ────────────────────────────────
model UserMetricTarget {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  programId   String?  @map("program_id") @db.Uuid
  metricKey   String   @map("metric_key")
  targetValue Float    @map("target_value")
  unit        String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@unique([userId, metricKey, programId])
  @@map("user_metric_targets")
}

// ─── Schedule Overrides ─────────────────────────────────
enum OverrideScope {
  TODAY_ONLY
  THIS_WEEK
  THIS_WEEK_FORWARD
}

enum OverrideAction {
  SKIP
  SWAP
  REPLACE
  REDUCE_DAYS
}

model ScheduleOverride {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  programId  String         @map("program_id") @db.Uuid
  blockId    String         @map("block_id") @db.Uuid
  scope      OverrideScope
  weekNumber Int            @map("week_number")
  dayOfWeek  Int?           @map("day_of_week")
  action     OverrideAction
  payload    Json
  createdAt  DateTime       @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  block   Block   @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@index([userId, programId, blockId, weekNumber])
  @@map("schedule_overrides")
}

// ─── Stretch Routines ───────────────────────────────────
model StretchRoutine {
  id          String               @id @default(uuid()) @db.Uuid
  userId      String               @map("user_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  user  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  items StretchRoutineItem[]

  @@index([userId])
  @@map("stretch_routines")
}

model StretchRoutineItem {
  id              String  @id @default(uuid()) @db.Uuid
  routineId       String  @map("routine_id") @db.Uuid
  exerciseId      String? @map("exercise_id") @db.Uuid
  name            String
  durationSeconds Int     @map("duration_seconds")
  bilateral       Boolean @default(false)
  sortOrder       Int     @map("sort_order")
  notes           String?

  routine  StretchRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercise Exercise?      @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  @@index([routineId])
  @@map("stretch_routine_items")
}
