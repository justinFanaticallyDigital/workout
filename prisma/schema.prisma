generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── NextAuth ─────────────────────────────────────────────
model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Users ───────────────────────────────────────────────
model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  name          String?
  password      String?
  image         String?
  emailVerified DateTime? @map("email_verified")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // R6: maintenance TDEE estimate, drives delta-vs-maintenance in
  // /gameplan/new picker NutritionCard. Replaces 2400 hardcoded baseline.
  maintenanceCalories Int? @map("maintenance_calories")

  accounts          Account[]
  sessions          Session[]
  goals             Goal[]
  programs          Program[]
  workouts          Workout[]
  exercises         Exercise[]
  exercisePrs       ExercisePr[]
  bodyMetrics       BodyMetric[]
  dailyMetrics      DailyMetric[]
  progressPhotos    ProgressPhoto[]
  injuries          Injury[]
  foodItems         FoodItem[]
  meals             Meal[]
  nutritionTargets  NutritionTarget[]
  mealPlans         MealPlan[]
  activityLogs      ActivityLog[]
  integrationData   IntegrationData[]
  userMetricTargets UserMetricTarget[]
  scheduleOverrides ScheduleOverride[]
  stretchRoutines   StretchRoutine[]
  checkIns          CheckIn[]
  lifestyleTargets  LifestyleTarget[]
  lifestyleLogs     LifestyleLog[]
  recommendations   Recommendation[]
  gameplanChanges   GameplanChange[]

  @@map("users")
}

// ─── Goals ───────────────────────────────────────────────
enum GoalType {
  weight
  bodyweight
  strength
  powerlifting
  competition
  frequency
  bodycomp
  custom
}

enum GoalStatus {
  active
  achieved
  abandoned
}

model Goal {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  programId   String?    @map("program_id") @db.Uuid
  type        GoalType
  title       String
  description String?
  priority    String     @default("primary")
  metric      String?
  startValue  Decimal?   @map("start_value")
  targetValue Decimal?   @map("target_value")
  targetUnit  String?    @map("target_unit")
  targetDate  DateTime?  @map("target_date") @db.Date
  status      GoalStatus @default(active)
  createdAt   DateTime   @default(now()) @map("created_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  program          Program?          @relation("GoalProgram", fields: [programId], references: [id], onDelete: SetNull)
  programs         Program[]         @relation("ProgramGoal")
  nutritionTargets NutritionTarget[]
  recommendations  Recommendation[]

  @@index([userId])
  @@index([programId])
  @@map("goals")
}

// ─── Programs ────────────────────────────────────────────
enum ProgramStatus {
  active
  completed
  paused
}

model Program {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  goalId        String?       @map("goal_id") @db.Uuid
  name          String
  description   String?
  startDate     DateTime?     @map("start_date") @db.Date
  endDate       DateTime?     @map("end_date") @db.Date
  durationWeeks Int?          @map("duration_weeks")
  status        ProgramStatus @default(active)
  // R11: canonical gameplan template tag — "lean_out" / "size_strength"
  // / "first_90_days" / etc., per spec §3's 8 templates. Stored as
  // String? (not enum) so future custom kinds drop in without a
  // migration. Currently only consumed by the goal engine's
  // refeed-due rule (Lean Out gating); UI for setting this lands in
  // a follow-on picker R.
  gameplanKind  String?       @map("gameplan_kind")
  createdAt     DateTime      @default(now()) @map("created_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal              Goal?              @relation("ProgramGoal", fields: [goalId], references: [id], onDelete: SetNull)
  goals             Goal[]             @relation("GoalProgram")
  blocks            Block[]
  benchmarks        ProgramBenchmark[]
  progressPhotos    ProgressPhoto[]
  userMetricTargets UserMetricTarget[]
  scheduleOverrides ScheduleOverride[]
  lifestyleTargets  LifestyleTarget[]
  lifestyleLogs     LifestyleLog[]
  recommendations   Recommendation[]
  gameplanChanges   GameplanChange[]

  @@index([userId])
  @@index([userId, status])
  @@map("programs")
}

model ProgramBenchmark {
  id          String    @id @default(uuid()) @db.Uuid
  programId   String    @map("program_id") @db.Uuid
  blockId     String?   @map("block_id") @db.Uuid
  label       String
  targetValue Decimal   @map("target_value")
  targetUnit  String    @map("target_unit")
  targetDate  DateTime? @map("target_date") @db.Date
  actualValue Decimal?  @map("actual_value")
  achievedAt  DateTime? @map("achieved_at")

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  block   Block?  @relation(fields: [blockId], references: [id], onDelete: SetNull)

  @@index([programId])
  @@index([blockId])
  @@map("program_benchmarks")
}

// ─── Blocks ──────────────────────────────────────────────
enum BlockStatus {
  active
  completed
  upcoming
}

model Block {
  id                  String      @id @default(uuid()) @db.Uuid
  programId           String      @map("program_id") @db.Uuid
  name                String
  description         String?
  blockNumber         Int         @map("block_number")
  startDate           DateTime?   @map("start_date") @db.Date
  endDate             DateTime?   @map("end_date") @db.Date
  durationWeeks       Int?        @map("duration_weeks")
  scheduleDaysPerWeek Int?        @map("schedule_days_per_week")
  phase               String?
  focus               String?
  status              BlockStatus @default(upcoming)
  createdAt           DateTime    @default(now()) @map("created_at")

  // R6: refeed weeks within this block (1-indexed). Drives the
  // /gameplan NutritionPanel "NEXT REFEED" footer (e.g. "SUN · WK 8").
  // Forward-compatible: future per-refeed notes/protocols can migrate
  // to a BlockRefeed join table embedding these as weekNumber.
  refeedWeeks Int[] @default([]) @map("refeed_weeks")

  program           Program            @relation(fields: [programId], references: [id], onDelete: Cascade)
  days              BlockDay[]
  workouts          Workout[]
  benchmarks        ProgramBenchmark[]
  nutritionTargets  NutritionTarget[]
  scheduleOverrides ScheduleOverride[]
  checkIns          CheckIn[]

  @@index([programId])
  @@map("blocks")
}

// ─── Block Days (Templates) ──────────────────────────────
enum DayType {
  lifting
  cardio
  conditioning
  mobility
  rest
}

model BlockDay {
  id        String  @id @default(uuid()) @db.Uuid
  blockId   String  @map("block_id") @db.Uuid
  dayNumber Int     @map("day_number")
  name      String
  dayType   DayType @default(lifting) @map("day_type")
  sortOrder Int     @map("sort_order")

  block     Block              @relation(fields: [blockId], references: [id], onDelete: Cascade)
  exercises BlockDayExercise[]
  workouts  Workout[]

  @@index([blockId])
  @@map("block_days")
}

// ─── Block Day Exercises (Templates) ─────────────────────
enum ProgressionType {
  linear
  double
  wave
  rpe_based
  percentage_based
  none
}

model BlockDayExercise {
  id                   String          @id @default(uuid()) @db.Uuid
  blockDayId           String          @map("block_day_id") @db.Uuid
  exerciseId           String          @map("exercise_id") @db.Uuid
  altExerciseId        String?         @map("alt_exercise_id") @db.Uuid
  sortOrder            Int             @map("sort_order")
  targetSets           Int?            @map("target_sets")
  targetRepRange       String?         @map("target_rep_range")
  targetRpe            String?         @map("target_rpe")
  progressionType      ProgressionType @default(none) @map("progression_type")
  progressionIncrement Decimal?        @map("progression_increment")
  notes                String?

  // R6: per-exercise variant catalogue. Drives the prototype's
  // VariantDropdown (logger-screens.jsx#VariantDropdown). Schema
  // landed in R6; UI surface still uses the existing Swap →
  // ExercisePicker path until a later UI-only PR wires VariantDropdown.
  variants String[] @default([])

  blockDay    BlockDay  @relation(fields: [blockDayId], references: [id], onDelete: Cascade)
  exercise    Exercise  @relation("primary", fields: [exerciseId], references: [id], onDelete: Cascade)
  altExercise Exercise? @relation("alternate", fields: [altExerciseId], references: [id], onDelete: SetNull)

  @@index([blockDayId])
  @@index([exerciseId])
  @@map("block_day_exercises")
}

// ─── Workouts (Logged Sessions) ──────────────────────────
model Workout {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  blockId    String?   @map("block_id") @db.Uuid
  blockDayId String?   @map("block_day_id") @db.Uuid
  date       DateTime  @db.Date
  weekNumber Int?      @map("week_number")
  startTime  DateTime? @map("start_time")
  endTime    DateTime? @map("end_time")
  notes      String?
  rating     Int?
  bodyWeight Decimal?  @map("body_weight")
  createdAt  DateTime  @default(now()) @map("created_at")

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  block     Block?            @relation(fields: [blockId], references: [id], onDelete: SetNull)
  blockDay  BlockDay?         @relation(fields: [blockDayId], references: [id], onDelete: SetNull)
  exercises WorkoutExercise[]

  @@index([userId])
  @@index([userId, date])
  @@index([blockId])
  @@map("workouts")
}

model WorkoutExercise {
  id         String  @id @default(uuid()) @db.Uuid
  workoutId  String  @map("workout_id") @db.Uuid
  exerciseId String  @map("exercise_id") @db.Uuid
  sortOrder  Int     @map("sort_order")
  notes      String?

  workout  Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sets     Set[]

  @@index([workoutId])
  @@index([exerciseId])
  @@map("workout_exercises")
}

model Set {
  id                String   @id @default(uuid()) @db.Uuid
  workoutExerciseId String   @map("workout_exercise_id") @db.Uuid
  setNumber         Int      @map("set_number")
  weight            Decimal?
  reps              Int?
  rir               Int?
  rpe               Decimal?
  isWarmup          Boolean  @default(false) @map("is_warmup")
  isPr              Boolean  @default(false) @map("is_pr")
  notes             String?

  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  exercisePrs     ExercisePr[]

  @@index([workoutExerciseId])
  @@map("sets")
}

// ─── Exercise Library ────────────────────────────────────
model Exercise {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String?  @map("user_id") @db.Uuid
  name             String
  movementPattern  String?  @map("movement_pattern")
  primaryMuscle    String?  @map("primary_muscle")
  secondaryMuscle1 String?  @map("secondary_muscle_1")
  secondaryMuscle2 String?  @map("secondary_muscle_2")
  equipment        String?
  isCustom         Boolean  @default(false) @map("is_custom")
  createdAt        DateTime @default(now()) @map("created_at")

  user                 User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercisePrs          ExercisePr[]
  workoutExercises     WorkoutExercise[]
  blockDayExercises    BlockDayExercise[]   @relation("primary")
  blockDayExercisesAlt BlockDayExercise[]   @relation("alternate")
  stretchRoutineItems  StretchRoutineItem[]

  @@unique([name])
  @@index([primaryMuscle])
  @@map("exercises")
}

model ExercisePr {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  exerciseId   String   @map("exercise_id") @db.Uuid
  prType       String   @map("pr_type") // weight, reps, volume, e1rm
  value        Decimal
  repsAtWeight Int?     @map("reps_at_weight")
  setId        String?  @map("set_id") @db.Uuid
  achievedAt   DateTime @default(now()) @map("achieved_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  set      Set?     @relation(fields: [setId], references: [id], onDelete: SetNull)

  @@index([userId, exerciseId])
  @@index([userId, exerciseId, prType])
  @@map("exercise_prs")
}

// ─── Body Metrics & Progress ─────────────────────────────
model BodyMetric {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  date       DateTime @db.Date
  weight     Decimal?
  bodyFatPct Decimal? @map("body_fat_pct")
  source     String   @default("manual") // manual, fitbit, scale
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
  @@map("body_metrics")
}

// ─── Daily Metrics (Fitbit activity/sleep/HR) ───────────
model DailyMetric {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  date           DateTime @db.Date
  // Activity
  steps          Int?
  activeMinutes  Int?     @map("active_minutes")
  caloriesBurned Int?     @map("calories_burned")
  // Sleep
  sleepMinutes   Int?     @map("sleep_minutes")
  sleepDeep      Int?     @map("sleep_deep") // minutes
  sleepLight     Int?     @map("sleep_light") // minutes
  sleepRem       Int?     @map("sleep_rem") // minutes
  sleepWake      Int?     @map("sleep_wake") // minutes
  // Heart Rate
  restingHr      Int?     @map("resting_hr")
  // R6: daily 1-10 stress self-report. Drives /gameplan
  // LifestylePanel StressCard (replaces 1-5→1-10 mapping from weekly
  // CheckIn.stress). Sleep-hours read uses existing sleepMinutes / 60.
  stress         Int?
  // Source
  source         String   @default("fitbit")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, source])
  @@index([userId])
  @@index([userId, date])
  @@map("daily_metrics")
}

model ProgressPhoto {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  programId String?  @map("program_id") @db.Uuid
  date      DateTime @db.Date
  imageUrl  String   @map("image_url")
  poseType  String   @default("front") @map("pose_type") // front, side, back, custom
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("progress_photos")
}

// ─── Injuries ────────────────────────────────────────────
model Injury {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  bodyPart     String    @map("body_part")
  description  String?
  severity     String    @default("tweak") // tweak, mild, moderate, severe
  onsetDate    DateTime  @map("onset_date") @db.Date
  resolvedDate DateTime? @map("resolved_date") @db.Date
  status       String    @default("active") // active, monitoring, resolved
  createdAt    DateTime  @default(now()) @map("created_at")

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes InjuryNote[]

  @@index([userId])
  @@map("injuries")
}

model InjuryNote {
  id           String    @id @default(uuid()) @db.Uuid
  injuryId     String    @map("injury_id") @db.Uuid
  date         DateTime  @db.Date
  note         String
  treatment    String?
  followUpDate DateTime? @map("follow_up_date") @db.Date

  injury Injury @relation(fields: [injuryId], references: [id], onDelete: Cascade)

  @@index([injuryId])
  @@map("injury_notes")
}

// ─── Nutrition ──────────────────────────────────────────
model FoodItem {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  name        String
  brand       String?
  barcode     String?
  servingSize Decimal  @default(100) @map("serving_size")
  servingUnit String   @default("g") @map("serving_unit")
  calories    Decimal  @default(0)
  protein     Decimal  @default(0)
  carbs       Decimal  @default(0)
  fat         Decimal  @default(0)
  fiber       Decimal? @default(0)
  sugar       Decimal? @default(0)
  sodium      Decimal? @default(0)
  source      String   @default("custom") // custom, usda, openfoodfacts
  externalId  String?  @map("external_id")
  isCustom    Boolean  @default(true) @map("is_custom")
  createdAt   DateTime @default(now()) @map("created_at")

  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealItems     MealItem[]
  mealPlanItems MealPlanItem[]

  @@index([userId])
  @@index([barcode])
  @@index([name])
  @@map("food_items")
}

enum MealType {
  breakfast
  lunch
  dinner
  snack
}

model Meal {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  date      DateTime @db.Date
  mealType  MealType @map("meal_type")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items MealItem[]

  @@index([userId])
  @@index([userId, date])
  @@map("meals")
}

model MealItem {
  id         String  @id @default(uuid()) @db.Uuid
  mealId     String  @map("meal_id") @db.Uuid
  foodItemId String  @map("food_item_id") @db.Uuid
  quantity   Decimal @default(1)
  sortOrder  Int     @default(0) @map("sort_order")

  meal     Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  foodItem FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Cascade)

  @@index([mealId])
  @@map("meal_items")
}

model NutritionTarget {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  label     String   @default("Default")
  calories  Decimal?
  protein   Decimal?
  carbs     Decimal?
  fat       Decimal?
  isActive  Boolean  @default(true) @map("is_active")
  blockId   String?  @map("block_id") @db.Uuid
  goalId    String?  @map("goal_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  block Block? @relation(fields: [blockId], references: [id], onDelete: SetNull)
  goal  Goal?  @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([blockId])
  @@index([goalId])
  @@map("nutrition_targets")
}

// ─── Meal Plans ──────────────────────────────────────────
model MealPlan {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  name          String
  days          Int      @default(7)
  calorieTarget Decimal? @map("calorie_target")
  proteinPct    Decimal? @map("protein_pct")
  carbsPct      Decimal? @map("carbs_pct")
  fatPct        Decimal? @map("fat_pct")
  mealsPerDay   Int      @default(3) @map("meals_per_day")
  preferences   String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  planDays MealPlanDay[]

  @@index([userId])
  @@map("meal_plans")
}

model MealPlanDay {
  id        String   @id @default(uuid()) @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  dayNumber Int      @map("day_number")
  createdAt DateTime @default(now()) @map("created_at")

  plan  MealPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  meals MealPlanMeal[]

  @@index([planId])
  @@map("meal_plan_days")
}

model MealPlanMeal {
  id        String   @id @default(uuid()) @db.Uuid
  dayId     String   @map("day_id") @db.Uuid
  mealType  MealType @map("meal_type")
  sortOrder Int      @default(0) @map("sort_order")

  day   MealPlanDay    @relation(fields: [dayId], references: [id], onDelete: Cascade)
  items MealPlanItem[]

  @@index([dayId])
  @@map("meal_plan_meals")
}

model MealPlanItem {
  id         String  @id @default(uuid()) @db.Uuid
  mealId     String  @map("meal_id") @db.Uuid
  foodItemId String  @map("food_item_id") @db.Uuid
  quantity   Decimal @default(1)
  sortOrder  Int     @default(0) @map("sort_order")

  meal     MealPlanMeal @relation(fields: [mealId], references: [id], onDelete: Cascade)
  foodItem FoodItem     @relation(fields: [foodItemId], references: [id], onDelete: Cascade)

  @@index([mealId])
  @@map("meal_plan_items")
}

// ─── Activity Log (non-lifting activities) ──────────────
enum ActivityType {
  STRETCH
  HIIT
  LISS
  CLASS
  CUSTOM
}

enum Intensity {
  LIGHT
  MODERATE
  HARD
}

model ActivityLog {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  date           DateTime     @db.Date
  activityType   ActivityType @map("activity_type")
  subType        String?      @map("sub_type")
  durationMin    Int          @map("duration_min")
  intensity      Intensity?
  distanceKm     Float?       @map("distance_km")
  avgHeartRate   Int?         @map("avg_heart_rate")
  caloriesBurned Int?         @map("calories_burned")
  instructor     String?
  studio         String?
  notes          String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("activity_logs")
}

// ─── Integration Data (Fitbit, Apple Health, etc.) ──────
enum IntegrationSource {
  FITBIT
  APPLE_HEALTH
  GARMIN
  MANUAL
  // R9 — non-user, non-device origin: a value derived from another
  // log (e.g. `protein_hits` counted from Meal/MealItem, or
  // `sessions_completed` derived from Workout). Spec §4.5 names
  // this `LogSource.DERIVED`; folded into IntegrationSource so we
  // don't carry two near-identical enums.
  DERIVED
}

model IntegrationData {
  id         String            @id @default(uuid()) @db.Uuid
  userId     String            @map("user_id") @db.Uuid
  source     IntegrationSource
  metricType String            @map("metric_type")
  value      Float
  date       DateTime          @db.Date
  rawPayload Json?             @map("raw_payload")
  createdAt  DateTime          @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, metricType, date])
  @@index([userId, metricType, date])
  @@map("integration_data")
}

// ─── User Metric Targets ────────────────────────────────
model UserMetricTarget {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  programId   String?  @map("program_id") @db.Uuid
  metricKey   String   @map("metric_key")
  targetValue Float    @map("target_value")
  unit        String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@unique([userId, metricKey, programId])
  @@map("user_metric_targets")
}

// ─── Schedule Overrides ─────────────────────────────────
enum OverrideScope {
  TODAY_ONLY
  THIS_WEEK
  THIS_WEEK_FORWARD
}

enum OverrideAction {
  SKIP
  SWAP
  REPLACE
  REDUCE_DAYS
}

model ScheduleOverride {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  programId  String         @map("program_id") @db.Uuid
  blockId    String         @map("block_id") @db.Uuid
  scope      OverrideScope
  weekNumber Int            @map("week_number")
  dayOfWeek  Int?           @map("day_of_week")
  action     OverrideAction
  payload    Json
  createdAt  DateTime       @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  block   Block   @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@index([userId, programId, blockId, weekNumber])
  @@map("schedule_overrides")
}

// ─── Stretch Routines ───────────────────────────────────
model StretchRoutine {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  items StretchRoutineItem[]

  @@index([userId])
  @@map("stretch_routines")
}

model StretchRoutineItem {
  id              String  @id @default(uuid()) @db.Uuid
  routineId       String  @map("routine_id") @db.Uuid
  exerciseId      String? @map("exercise_id") @db.Uuid
  name            String
  durationSeconds Int     @map("duration_seconds")
  bilateral       Boolean @default(false)
  sortOrder       Int     @map("sort_order")
  notes           String?

  routine  StretchRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercise Exercise?      @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  @@index([routineId])
  @@map("stretch_routine_items")
}

// ─── Lifestyle Targets (R6) ─────────────────────────────
//
// Per-user, optionally per-program standing targets for sleep /
// stress / protein / etc. Drives the /gameplan/new picker
// LifestylePicksCard ("SLEEP · 7+ H" tags) and the dashboard
// SleepCard / StressCard / ProteinHitCard target bands.
//
// Distinct from UserMetricTarget (which is a single Float per
// metric) because lifestyle goals carry comparator semantics — a
// stress target reads "≤ 5" and a protein target reads "≥ 1g/lb".
model LifestyleTarget {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  programId  String?  @map("program_id") @db.Uuid
  /// Stable key: "sleep_hours_min" / "stress_max" / "protein_g_per_lb" / etc.
  key        String
  value      Float
  unit       String
  /// "gte" / "lte" / "eq" — drives the in-band check on dashboard cards.
  comparator String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@unique([userId, programId, key])
  @@index([userId])
  @@map("lifestyle_targets")
}

// ─── Lifestyle Logs (R9) ────────────────────────────────
// One row per (user, date, variableKey). Daily-cadence variables
// fill every day; weekly-cadence variables (z2_minutes,
// balance_minutes, sessions_completed) write to the week's last
// day; as-needed variables (pain_check) just leave gaps. The
// goal-engine ingests the last 7 rows per tracked key into
// EngineState.lifestyle for the lifestyle-streak-broken and
// pain-flag rules. Numeric variables use numValue (sleep hours,
// steps); enum/scale variables use textValue ("GREEN" | "1"-"5").
model LifestyleLog {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  programId   String?           @map("program_id") @db.Uuid
  date        DateTime          @db.Date
  variableKey String            @map("variable_key")
  numValue    Float?            @map("num_value")
  textValue   String?           @map("text_value")
  unit        String?
  source      IntegrationSource @default(MANUAL)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@unique([userId, date, variableKey])
  @@index([userId, date])
  @@index([userId, variableKey, date])
  @@map("lifestyle_logs")
}

// ─── Weekly Check-Ins ────────────────────────────────────
model CheckIn {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  date       DateTime @db.Date
  weekNumber Int?     @map("week_number")
  blockId    String?  @map("block_id") @db.Uuid

  // Subjective ratings (1–5 scale)
  energy       Int?
  sleepQuality Int? @map("sleep_quality")
  soreness     Int?
  stress       Int?
  motivation   Int?

  // Adherence (% 0–100)
  liftAdherence      Int? @map("lift_adherence")
  cardioAdherence    Int? @map("cardio_adherence")
  nutritionAdherence Int? @map("nutrition_adherence")

  // Free text
  wins      String?
  struggles String?
  notes     String?

  createdAt DateTime @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  block Block? @relation(fields: [blockId], references: [id], onDelete: SetNull)

  // R8: recommendations generated by the Goal Engine on this CheckIn POST.
  recommendations Recommendation[]

  @@unique([userId, date])
  @@index([userId])
  @@index([userId, date])
  @@map("check_ins")
}

// ─── Goal Engine (R8) ────────────────────────────────────
//
// Engine output rows — one per fired recommendation rule. The
// engine fires synchronously on POST /api/checkins (per R8 hot
// question 2) and returns the freshly-generated rows inline.
// Status drives the lifecycle: pending → applied | dismissed |
// expired. `suggestedField` + `suggestedValue` pre-stage a
// Planning Mode draft when the user taps Apply.

enum RecommendationKind {
  // R9 adds lifestyle_streak_broken + pain_flag.
  // R10 adds adherence_low_streak.
  // R11 adds refeed_due + deload_shift — engine-complete; all 9
  // spec §8.4 rules now have a corresponding kind.
  behind_target
  ahead_target
  adherence_low
  plateau_detected
  lifestyle_streak_broken
  pain_flag
  adherence_low_streak
  refeed_due
  deload_shift
}

enum RecommendationStatus {
  pending
  applied
  dismissed
  expired
}

enum RecommendationSeverity {
  info
  warning
  urgent
}

model Recommendation {
  id              String                 @id @default(uuid()) @db.Uuid
  userId          String                 @map("user_id") @db.Uuid
  // R8: optional program scope — null for system-wide recs.
  programId       String?                @map("program_id") @db.Uuid
  // R8: optional goal scope — null for adherence rules that aren't goal-tied.
  goalId          String?                @map("goal_id") @db.Uuid
  // R8: links a recommendation back to the CheckIn that triggered it.
  checkInId       String?                @map("check_in_id") @db.Uuid
  kind            RecommendationKind
  status          RecommendationStatus   @default(pending)
  // R8: spec §8.4 severity — drives card tone (info/warning/urgent).
  severity        RecommendationSeverity @default(info)
  // R8: short label rendered as card heading.
  title           String
  // R8: full explanation rendered in card body.
  body            String
  // R8: field name to pre-stage in Planning Mode (e.g. "calories").
  suggestedField  String?                @map("suggested_field")
  // R8: JSON-stringified new value for that field.
  suggestedValue  String?                @map("suggested_value")
  // R8: engine state at trigger time, for diagnostics.
  snapshotData    Json?                  @map("snapshot_data")
  // R8: optional dismissal reason (when status=dismissed).
  dismissedReason String?                @map("dismissed_reason")
  createdAt       DateTime               @default(now()) @map("created_at")
  resolvedAt      DateTime?              @map("resolved_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  goal    Goal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)
  checkIn CheckIn? @relation(fields: [checkInId], references: [id], onDelete: SetNull)

  // R10: GameplanChange rows that were written when this rec was applied.
  changes GameplanChange[]

  @@index([userId, status])
  @@index([programId])
  @@index([checkInId])
  @@map("recommendations")
}

// ─── Gameplan Changes (R10) ──────────────────────────────
//
// Audit trail of every plan mutation, regardless of source. Spec
// §4.3 motivates this as the substrate for "undo" + "applied
// recommendations" history. Each row captures field path, old/new
// values (Json so the engine and UI can stash any shape), and the
// trigger source (CHECK_IN_APPLY when a recommendation Apply wrote
// it; PLANNING_MODE when Planning Mode's diff-apply did; MANUAL_EDIT
// for direct edits not yet ported to the audit pipeline).
//
// The R10 adherence-low-streak rule reads `kind='adherence_low'`
// Recommendation history rather than this table — the streak rule
// fires on rule-fired-twice, not user-applied-twice. GameplanChange
// is purely about plan deltas.

enum GameplanChangeSource {
  CHECK_IN_APPLY
  PLANNING_MODE
  MANUAL_EDIT
}

model GameplanChange {
  id               String               @id @default(uuid()) @db.Uuid
  userId           String               @map("user_id") @db.Uuid
  programId        String?              @map("program_id") @db.Uuid
  // R10: source of this change. CHECK_IN_APPLY rows always have a
  // recommendationId; PLANNING_MODE rows usually don't.
  source           GameplanChangeSource
  // R10: dotted field path. "nutrition.calories" / "lifestyle.{key}.target"
  // / "goal.targetDate". The Apply dispatcher in
  // /api/recommendations/[id]/apply enumerates the full set.
  field            String
  // R10: previous value (Json so a number, string, or object all fit).
  oldValue         Json?                @map("old_value")
  // R10: applied value.
  newValue         Json?                @map("new_value")
  // R10: optional human-entered reason (Planning Mode "note" field).
  reason           String?
  // R10: optional link back to the Recommendation that drove the apply.
  recommendationId String?              @map("recommendation_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  program        Program?        @relation(fields: [programId], references: [id], onDelete: SetNull)
  recommendation Recommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([programId, createdAt])
  @@index([recommendationId])
  @@map("gameplan_changes")
}
